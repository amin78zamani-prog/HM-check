<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal"
    android:background="#F5F6FA">

    <!-- عنوان داشبورد امنیتی -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="سیستم تشخیص نشت پنهان و ناهنجاری (HM-check)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:layout_marginBottom="10dp" />

    <!-- کارت وضعیت کلی امنیت سیستم -->
    <LinearLayout
        android:id="@+id/cardStatus"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#27AE60"
        android:elevation="4dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/txtStatusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="وضعیت: امن (بدون نشت پنهان)"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStatusDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تمامی پکیج‌ها در وضعیت نرمال هستند"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <!-- کانتینر رسم نمودار خطی ترافیک کلی -->
    <com.hm.check.LineChartView
        android:id="@+id/lineChart"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:layout_marginBottom="10dp" />

    <!-- بخش لیست زنده مصرف و وضعیت نشت برنامه‌ها -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="پایش لحظه‌ای ترافیک و وضعیت نشت پنهان اپلیکیشن‌ها:"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#555555"
        android:layout_marginBottom="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:elevation="2dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/txtAppTrafficList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="در حال اسکن سوکت‌ها و پردازش ترافیک برنامه‌ها...\n"
            android:textSize="12sp"
            android:textColor="#333333"
            android:fontFamily="monospace" />
    </ScrollView>

    <!-- بخش لاگ رویدادهای امنیتی -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:background="#2C3E50"
        android:padding="6dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/txtLogHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[System] مانیتورینگ امنیتی لایه میزبان فعال شد.\n"
            android:textSize="10sp"
            android:textColor="#ECF0F1"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
