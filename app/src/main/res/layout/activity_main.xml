<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    android:background="#F5F6FA">

    <!-- عنوان داشبورد -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="داشبورد امنیت شبکه HM-check"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:layout_marginBottom="24dp" />

    <!-- کارت وضعیت امنیتی (نشانگر زنده) -->
    <LinearLayout
        android:id="@+id/cardStatus"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#27AE60"
        android:elevation="4dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/txtStatusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="سیستم ایمن"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStatusDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="هیچ ناهنجاری در شبکه شناسایی نشد"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- بخش آمار و اطلاعات زنده -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="2dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/txtSockets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="سوکت‌های فعال: ۱۴"
            android:textSize="16sp"
            android:textColor="#333333"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/txtTraffic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ترافیک شبکه: عادی"
            android:textSize="16sp"
            android:textColor="#333333" />
    </LinearLayout>

    <!-- دکمه مخصوص جلسه دفاع برای تست ناهنجاری -->
    <Button
        android:id="@+id/btnSimulate"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="شبیه‌سازی تهدید امنیتی"
        android:textSize="16sp"
        android:backgroundTint="#E74C3C"
        android:textColor="#FFFFFF" />

</LinearLayout>
