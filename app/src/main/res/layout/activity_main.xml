<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal"
    android:background="#F5F6FA">

    <!-- عنوان داشبورد امنیتی فدریت -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="داشبورد امنیت فدریت و تشخیص ناهنجاری (HM-check)"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:layout_marginBottom="10dp" />

    <!-- کارت وضعیت ریسک مدل فدریت -->
    <LinearLayout
        android:id="@+id/cardStatus"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#27AE60"
        android:elevation="4dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/txtStatusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="وضعیت ریسک فدریت: امن (پایدار)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStatusDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ترافیک واقعی و پارامترهای مدل در وضعیت نرمال"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- نمودار دوخطی همزمان -->
    <com.hm.check.LineChartView
        android:id="@+id/lineChart"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:layout_marginBottom="8dp" />

    <!-- بخش مانیتورینگ پروسه‌ها -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="وضعیت نود محلی و ارزیابی ریسک یادگیری فدریت:"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#555555"
        android:layout_marginBottom="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:elevation="2dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/txtAppTrafficList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="در حال مقداردهی اولیه مدل یادگیری فدریت در لبه شبکه...\n"
            android:textSize="12sp"
            android:textColor="#333333"
            android:fontFamily="monospace" />
    </ScrollView>

    <!-- عنوان بخش لاگ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="گزارش رویدادهای سیستم (Audit Logs):"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#555555"
        android:layout_marginBottom="4dp" />

    <!-- کادر نمایش لاگ‌ها -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#2C3E50"
        android:padding="6dp"
        android:elevation="2dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/txtLogHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[FL-Node] پروتکل آموزشی امن فعال شد.\n"
            android:textSize="10sp"
            android:textColor="#ECF0F1"
            android:fontFamily="monospace" />
    </ScrollView>

    <!-- دکمه ذخیره لاگ‌ها (کاملاً وسط‌چین‌شده و فعال) -->
    <Button
        android:id="@+id/btnSaveLogs"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="ذخیره فایل لاگ‌ها"
        android:textSize="12sp"
        android:textStyle="bold"
        android:backgroundTint="#2C3E50"
        android:textColor="#FFFFFF"
        android:layout_gravity="center_horizontal" />

</LinearLayout>
